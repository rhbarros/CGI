// BACKUP 2G Ericsson - MML no BSC (eaw)
// A ferramenta abre o BSC do site (coluna J da CGI) e:
//  1) roda as linhas com {CELL} da parte DESCOBRIR para cada célula do site (coluna L da CGI) e acha os TGs (RXOTG-n);
//  2) roda o bloco com {TG} uma vez para cada TG encontrado;
//  3) roda as linhas com {CELL} da parte CELULAS para cada célula.
// Só comandos de impressão (terminam em P): não alteram o BSC.
// ===== DESCOBRIR =====
RXTCP:MOTY=RXOTG,CELL={CELL};
// ===== TG =====
RXASP:MO=RXOCF-{TG};
RXASP:MO=RXOTG-{TG};
RXMFP:MO=RXOTG-{TG};
RXMFP:MO=RXOCF-{TG};
RXMFP:MO=RXOCF-{TG},SUBORD,FAULTY;
RXMSP:MO=RXOTG-{TG},SUBORD;
// ===== CELULAS =====
RLCRP:CELL={CELL};
